# Main collection stub for Defold starter
# Open this file in the Defold Editor and convert these entries to real instances.

instances:
- name: "player_factory_spawn"
  prototype: "/player_factory.factory"
  position: -250, 0, 0

- name: "ai_player_factory_spawn"
  prototype: "/ai_player_factory.factory"
  position: 250, 0, 0

- name: "ball_factory_spawn"
  prototype: "/ball_factory.factory"
  position: 0, 0, 0

# Notes:
# - In the Defold Editor, create a collection, drag the .factory files into the collection,
#   or create Game Objects using the .go prototypes and add them to the scene.
# - Adjust positions and animations in the Editor; the placeholder atlas uses 'placeholder'.
-- main.collection (editor-ready stub)
-- This file is a textual stub describing the collection contents so you can recreate it quickly in the Defold editor.

-- Collection: main.collection
-- Instances:
-- 1) main (Game Object)
--    - Script: /scripts/main.script
--    - Id: main
--    - Position: 0, 0, 0

-- 2) ball (Game Object)
--    - Prefab/GO: prototype/defold/editor_fixtures/ball.go (create via editor)
--    - Script: /scripts/ball.script
--    - Sprite: placeholder.atlas -> placeholder
--    - Id: ball
--    - Position: 0, 0, 0

-- 3) player (Game Object)
--    - Prefab/GO: prototype/defold/editor_fixtures/player.go (create via editor)
--    - Script: /scripts/player.script
--    - Sprite: placeholder.atlas -> placeholder
--    - Id: player
--    - Position: -100, 0, 0

-- 4) spawner (Game Object)
--    - Script: /scripts/spawner.script
--    - Id: spawner
--    - Position: 0, 0, 0

-- Quick recreate steps (in Defold editor):
-- 1. File -> New -> Collection -> name it `main.collection`.
-- 2. Create `main.go` game object, add Script component `/scripts/main.script`, set Id `main`.
-- 3. Create `ball.go` game object, add Sprite (placeholder.atlas/placeholder) and Script `/scripts/ball.script`, set Id `ball`.
-- 4. Create `player.go` game object, add Sprite and Script `/scripts/player.script`, set Id `player`.
-- 5. Drag `main.go`, `ball.go`, and `player.go` into `main.collection`, set positions as above, save and run.

-- If you prefer to import a real `.collection`, use the Defold editor to save this collection after creating the objects; the editor will generate a proper `.collectionc`/`.collection` file in the project.
