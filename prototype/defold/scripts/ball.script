-- ball.script — basic ball behaviour stub

local M = {}

function init(self)
  self.velocity = vmath.vector3(0,0,0)
  self.spin = 0
end

function update(self, dt)
  local pos = go.get_position()
  pos = pos + self.velocity * dt
  go.set_position(pos)
  -- apply simple damping
  self.velocity = self.velocity * (1 - math.min(dt * 1.5, 0.99))
end

function on_message(self, message_id, message, sender)
  if message_id == hash("kick") then
    -- message: { direction = vmath.vector3(), power = number }
    self.velocity = message.direction * (message.power or 400)
  end
end

return M
