-- ball.script — basic ball behaviour with simple physics

local M = {}

function init(self)
  self.velocity = vmath.vector3(0,0,0)
  self.damping = 0.98
  self.mass = 1.0
end

function update(self, dt)
  local pos = go.get_position()
  pos = pos + self.velocity * dt
  go.set_position(pos)
  -- simple linear damping
  local damp = math.max(0, 1 - (1 - self.damping) * dt * 60)
  self.velocity = self.velocity * damp
  -- very small threshold to zero
  if vmath.length(self.velocity) < 1 then self.velocity = vmath.vector3(0,0,0) end
end

function on_message(self, message_id, message, sender)
  if message_id == hash("kick") then
    -- message: { direction = vmath.vector3(), power = number }
    local dir = message.direction or vmath.vector3(1,0,0)
    local power = message.power or 400
    -- apply impulse (simple)
    self.velocity = self.velocity + dir * (power / math.max(0.001, self.mass))
  elseif message_id == hash("set_velocity") then
    self.velocity = message.velocity or self.velocity
  end
end

return M
