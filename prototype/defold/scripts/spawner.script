-- spawner.script (configurable)
local vmath = vmath

function init(self)
  -- Configuration: teams, counts and optional explicit positions
  self.spawn_config = {
    teams = {
      { team = 1, count = 1, factory = "#player_factory", positions = { vmath.vector3(-250, 0, 0) } },
      { team = 2, count = 1, factory = "#ai_player_factory", positions = { vmath.vector3(250, 0, 0) } },
    },
    ball = { factory = "#ball_factory", position = vmath.vector3(0, 0, 0), id = "ball" }
  }

  -- Spawn teams
  for _, team_cfg in ipairs(self.spawn_config.teams) do
    for i = 1, team_cfg.count do
      local pos = team_cfg.positions and team_cfg.positions[i] or team_cfg.positions and team_cfg.positions[1] or vmath.vector3(0,0,0)
      local ok, inst = pcall(function() return factory.create(team_cfg.factory, pos) end)
      if ok and inst then
        local props = { team = team_cfg.team, id = (team_cfg.team .. "_" .. i), ball_path = "/ball#ball" }
        msg.post(inst, "set_properties", props)
      else
        print("Spawner: failed to create instance from factory", tostring(team_cfg.factory))
      end
    end
  end

  -- Spawn ball
  local okb, ib = pcall(function() return factory.create(self.spawn_config.ball.factory, self.spawn_config.ball.position) end)
  if okb and ib then
    msg.post(ib, "set_properties", { id = self.spawn_config.ball.id })
  else
    print("Spawner: failed to create ball from factory", tostring(self.spawn_config.ball.factory))
  end
end

function update(self, dt)
  -- passive spawner
end

-- Notes:
-- - Edit `self.spawn_config` above to change counts and positions before the game starts.
-- - Factories referenced use component ids defined on `spawner.go` ("#player_factory", "#ai_player_factory", "#ball_factory").
