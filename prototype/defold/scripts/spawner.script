-- spawner.script — attempts to spawn player and ball at runtime
-- Usage:
-- 1) Create `player.go` and `ball.go` in the editor and create factories from them named
--    `player_factory` and `ball_factory` (right-click GO -> Create Factory).
-- 2) Place the factories in the root collection (or adjust the paths below).
-- 3) Add a game object with this script to `main.collection` to auto-spawn on init.

local M = {}

function init(self)
  -- factory URLs (adjust if you placed factories in subfolders)
  self.player_factory_url = "/player_factory#player_factory"
  self.ball_factory_url = "/ball_factory#ball_factory"
  self.spawn_positions = {
    player = vmath.vector3(-100, 0, 0),
    ball = vmath.vector3(0, 0, 0)
  }

  -- try to create instances via factories (pcall to avoid errors if not present)
  local ok1, id1 = pcall(function() return factory.create(self.player_factory_url, self.spawn_positions.player) end)
  local ok2, id2 = pcall(function() return factory.create(self.ball_factory_url, self.spawn_positions.ball) end)

  if ok1 and ok2 then
    print("Spawner: created player and ball via factories")
  else
    if not ok1 then print("Spawner: player_factory not found at " .. self.player_factory_url) end
    if not ok2 then print("Spawner: ball_factory not found at " .. self.ball_factory_url) end
    print("Spawner: To auto-spawn, create factories named 'player_factory' and 'ball_factory' in the editor.")
  end
end

return M
