-- player.script — simple Defold component stub

local M = {}

function init(self)
  self.speed = 120 -- pixels per second (tune from game_constants)
  self.velocity = vmath.vector3(0,0,0)
  self.target = nil
  msg.post("", "acquire_input_focus")
end

function update(self, dt)
  if self.target then
    local pos = go.get_position()
    local dir = vmath.normalize(self.target - pos)
    local move = dir * self.speed * dt
    go.set_position(pos + move)
  end
end

function on_input(self, action_id, action)
  if action_id == hash("touch") or action_id == hash("click") then
    -- store last touched position as target (example)
    self.target = vmath.vector3(action.x, action.y, 0)
  end
end

return M
